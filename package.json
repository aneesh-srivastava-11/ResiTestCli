{
  "name": "resitest",
  "version": "1.0.0",
  "description": "Production-grade CLI tool for API resilience, load testing, SLA validation, and Swagger endpoint discovery",
  "main": "./bin/resitest.js",
  "type": "module",
  "bin": {
    "resitest": "./bin/resitest.js"
  },
  "scripts": {
    "start": "node bin/resitest.js",
    "test:local": "node bin/resitest.js run http://localhost:3000 --users 10 --duration 5",
    "postinstall": "node bin/postinstall.js"
  },
  "keywords": [
    "load-testing",
    "performance-testing",
    "resilience-testing",
    "sla-validation",
    "swagger",
    "openapi",
    "cli",
    "concurrency"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src"
  ],
  "author": "Aneesh Srivastava",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "resitest": "^1.0.0"
  }
}
